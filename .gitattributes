SourceArt/**/*.obj filter=lfs diff=lfs merge=lfs -text

# Fonts / archives / documents
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z  filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text

# Documentation images stay in plain git so they render in the README and
# cost no LFS bandwidth. Must come last: later rules win.
docs/**/*.png  !filter !diff !merge -text
docs/**/*.jpg  !filter !diff !merge -text
docs/**/*.jpeg !filter !diff !merge -text
