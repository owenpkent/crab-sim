# Let git detect text and normalize to LF in the repo. No forced working-tree
# EOL: this project gets opened on Windows too (Nimbus's vJoy/ViGEm/driver
# stack is Windows-only) and the UE editor writes CRLF .ini files there.
* text=auto

# Scripts must keep the line endings their interpreter expects.
*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Source and config: always text, always diffable.
*.h        text
*.hpp      text
*.c        text
*.cpp      text
*.inl      text
*.cs       text
*.ini      text
*.json     text
*.md       text
*.py       text
*.usf      text
*.ush      text
*.uproject text
*.uplugin  text

# ---- Git LFS ----
# Explicit extensions, no wildcards like Content/**: UEGitPlugin parses this
# file to find lockable types and cannot expand globs.
#
# `lockable` is deliberately absent. It makes every matching file read-only
# until `git lfs lock`, which is pure friction for one person. Run
# Scripts/enable-locking.sh before a second contributor joins.

# Unreal
*.uasset  filter=lfs diff=lfs merge=lfs -text
*.umap    filter=lfs diff=lfs merge=lfs -text
*.ubulk   filter=lfs diff=lfs merge=lfs -text
*.uexp    filter=lfs diff=lfs merge=lfs -text
*.upk     filter=lfs diff=lfs merge=lfs -text
*.locres  filter=lfs diff=lfs merge=lfs -text
*.locmeta filter=lfs diff=lfs merge=lfs -text

